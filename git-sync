#!/usr/bin/env bash

# Configuration
BRANCH="master" # Change to your target branch (e.g., master, dev)
COMMIT_MSG="Auto-sync android: $(date '+%Y-%m-%d %H:%M:%S')"
NEW_CHANGES="$(git status --porcelain)"


# 1. Fetch remote changes to see what's new
git fetch origin "$BRANCH"

# 2. Check for local modifications or untracked changes
if [ -n "$NEW_CHANGES" ]; then
    echo "Local changes found - commit them."
    
    # Stage all changes (tracked and untracked)
    git add -A
    
    git commit -m "$COMMIT_MSG"
fi

# 3. Pull remote changes safely
if ! git pull --rebase origin "$BRANCH"; then
    echo "ERROR: Conflict detected during pull/rebase. Please resolve manually."
    exit 1
fi

# 4. Push local changes
if [ -n "$NEW_CHANGES" ]; then
    echo "Push local changes to remote..."
    
    if git push origin "$BRANCH"; then
        echo "SUCCESS: Repository successfully synchronized."
    else
        echo "ERROR: Push failed. Check your network or permissions."
        exit 1
    fi
else
    echo "SUCCESS: Everything is up to date."
fi
